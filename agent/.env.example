AGENT_MODE=llm

# OpenAI-compatible chat completions API. Zhipu BigModel example.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-5.3-flash
OPENAI_TEMPERATURE=0.2

AGENT_MAX_TOOL_CALLS=12
AGENT_TICKS_PER_TURN=1
AGENT_MAX_TURNS=300
AGENT_EXPLAIN=false
AGENT_EVENT_LIMIT=60
AGENT_PORT=8788
# 设为 1 后，Cloudflare 等穿透域名才能打开页面并操作仿真。默认只允许本机。
AGENT_PUBLIC=0

AGENT_ARCHITECTURE=multi
